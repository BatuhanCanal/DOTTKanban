# -----------------------------------------------------------------------------
# DOTT Kanban — ortam degiskenleri
# Bu dosyayi ".env" olarak kopyalayip degerleri doldurun:
#   cp .env.example .env
# ".env" dosyasi git'e GIRMEZ (.gitignore'da).
# -----------------------------------------------------------------------------

# --- PLANKA ------------------------------------------------------------------

# Planka'nin disaridan erisilecegi adres. Sunucuya kurunca kendi alan adinizi
# yazin, orn: https://kanban.dott.example.com
PLANKA_BASE_URL=http://localhost:3000
PLANKA_PORT=3000

# Tum oturum token'lari bununla imzalanir. MUTLAKA degistirin:
#   openssl rand -hex 32
PLANKA_SECRET_KEY=degistir-beni-openssl-rand-hex-32

# Ilk acilista olusturulacak yonetici hesabi
PLANKA_ADMIN_EMAIL=admin@dott.local
PLANKA_ADMIN_PASSWORD=degistir-beni
PLANKA_ADMIN_NAME=DOTT Yonetici
PLANKA_ADMIN_USERNAME=admin

# Varsayilan arayuz dili (tr-TR, en-US, ...)
PLANKA_DEFAULT_LANGUAGE=tr-TR

# --- COMPANION ---------------------------------------------------------------

# Companion'in kendi kullanici sistemi YOKTUR: herkes kendi Planka hesabiyla
# girer, istekler o kullanici adina yapilir. Bu yuzden burada saklanan bir
# servis hesabi veya ortak sifre yoktur.

COMPANION_PORT=3001

# HTTPS arkasinda yayina alirken true yapin (oturum cerezi sadece guvenli
# baglantida gonderilir). Duz http ile test ederken false kalmali.
COMPANION_COOKIE_SECURE=false
